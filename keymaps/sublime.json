{
  "body.platform-darwin": {
    "shift-cmd-p": "core:toggle-telescope",
    "cmd-alt-j": "core:show-editor-action-menu",
    "cmd-ctrl-shift-f": "view:toggle-distraction-free",
    "cmd-k cmd-b": "view:toggle-sidebar"
  },
  ".platform-darwin .cm-editor .cm-scroller": {
    "shift-ctrl-k": "editor:delete-line",
    "ctrl-left": "editor:go-subword-left",
    "ctrl-right": "editor:go-subword-right",
    "cmd-d": "editor:select-next-occurrence",
    "shift-cmd-space": "editor:select-parent-syntax",
    "ctrl-shift-m": "editor:select-matching-bracket",
    "ctrl-m": "editor:go-matching-bracket",
    "cmd-ctrl-up": "editor:move-line-up",
    "cmd-ctrl-down": "editor:move-line-down",
    "cmd-/": "editor:toggle-comment",
    "cmd-shift-j": "editor:join-lines",
    "shift-cmd-d": "editor:copy-line-down",
    "cmd-k cmd-d": "editor:skip-and-select-next-occurrence",
    "cmd-k cmd-k": "editor:delete-wrapped-line-right",
    "cmd-k cmd-backspace": "editor:delete-wrapped-line-left",
    "cmd-k cmd-u": "editor:upcase-at-cursor",
    "cmd-k cmd-l": "editor:downcase-at-cursor",
    "cmd-k cmd-c": "editor:show-in-center"
  },
  ".platform-darwin .mde.has-selection .cm-editor .cm-scroller": {
    "shift-cmd-l": "editor:split-selection-by-line"
  },
  "body.platform-linux, body.platform-win32": {
    "ctrl-shift-p": "core:toggle-telescope",
    "ctrl-alt-j": "core:show-editor-action-menu",
    "shift-f11": "view:toggle-distraction-free",
    "ctrl-k ctrl-b": "view:toggle-sidebar"
  },
  ".platform-linux .cm-editor .cm-scroller, .platform-win32 .cm-editor .cm-scroller": {
    "shift-ctrl-k": "editor:delete-line",
    "alt-left": "editor:go-subword-left",
    "alt-right": "editor:go-subword-right",
    "ctrl-d": "editor:select-next-occurrence",
    "shift-ctrl-space": "editor:select-parent-syntax",
    "shift-ctrl-m": "editor:select-matching-bracket",
    "ctrl-m": "editor:go-matching-bracket",
    "shift-ctrl-up": "editor:move-line-up",
    "shift-ctrl-down": "editor:move-line-down",
    "ctrl-/": "editor:toggle-comment",
    "shift-ctrl-d": "editor:copy-line-down",
    "ctrl-k ctrl-d": "editor:skip-and-select-next-occurrence",
    "ctrl-k ctrl-k": "editor:delete-wrapped-line-right",
    "ctrl-k ctrl-backspace": "editor:delete-wrapped-line-left",
    "ctrl-k ctrl-u": "editor:upcase-at-cursor",
    "ctrl-k ctrl-l": "editor:downcase-at-cursor",
    "ctrl-k ctrl-c": "editor:show-in-center",
    "ctrl-alt-up": "editor:select-lines-upward",
    "ctrl-alt-down": "editor:select-lines-downward",
    "ctrl-h": "editor:replace"
  },
  ".platform-linux .mde.has-selection .cm-editor .cm-scroller, .platform-win32 .mde.has-selection .cm-editor .cm-scroller": {
    "shift-ctrl-l": "editor:split-selection-by-line"
  },
  ".platform-linux .mde:not(.is-empty) .cm-editor .cm-scroller, .platform-win32 .mde:not(.is-empty) .cm-editor .cm-scroller": {
    "ctrl-t": "editor:transpose-chars"
  }
}
